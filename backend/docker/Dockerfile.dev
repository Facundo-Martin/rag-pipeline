FROM python:3.14-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 1. Install System Dependencies for Docling/OCR (Bypass Fastly CDN with correct Security routing)
RUN rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* && \
    apt-get -o Acquire::http::Pipeline-Depth=0 -o Acquire::http::No-Cache=true -o Acquire::BrokenProxy=true update && \
    apt-get -o Acquire::http::Pipeline-Depth=0 -o Acquire::http::No-Cache=true -o Acquire::BrokenProxy=true install -y --no-install-recommends \
    libgl1=1.6.0-1 \
    libglib2.0-0=2.74.6-2+deb12u9 \
    tesseract-ocr=5.3.0-2 \
    tesseract-ocr-eng=1:4.1.0-2 \
    curl=7.88.1-10+deb12u15 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. Setup Environment Variables
ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    # Explicit cache directories for the non-root user
    HF_HOME="/home/appuser/.cache/huggingface" \
    DOCLING_HOME="/home/appuser/.cache/docling"

# 3. Create non-root user EARLY and set up cache and app directories
RUN adduser --disabled-password --gecos '' --uid 1000 appuser && \
    mkdir -p /home/appuser/.cache/huggingface /home/appuser/.cache/docling /app && \
    chown -R appuser:appuser /home/appuser/.cache /app

USER 1000
WORKDIR /app

# 4. Install dependencies
COPY --chown=appuser:appuser uv.lock pyproject.toml ./
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --no-install-project

# 5. Copy the rest of the application
COPY --chown=appuser:appuser . /app
RUN --mount=type=cache,target=/home/appuser/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
